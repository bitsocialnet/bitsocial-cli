#!/usr/bin/env node

// Checks the Node version, then loads the CLI from run-cli.js. On a Node older than package.json's engines.node the
// CLI used to get as far as starting kubo and then fail with "Cannot read properties of undefined (reading 'bind')".
//
// Static imports load before anything runs, so this file imports nothing but "fs" and the guard. Everything else is
// in run-cli.js, behind the check, because any other import may be what breaks on an old Node.
//
// The check is reached on Node 18.19 and later 18.x releases, and on 20.10 and later. Older versions cannot load an
// extensionless file in a "type": "module" package and fail with ERR_UNKNOWN_FILE_EXTENSION before this file runs.
import { readFileSync } from "fs";
import { unsupportedNodeMessage } from "./node-version-guard.js";

var requiredNode;
try {
    requiredNode = JSON.parse(readFileSync(new URL("../package.json", import.meta.url), "utf-8")).engines.node;
} catch (error) {
    // No readable requirement, so nothing to enforce.
}

var unsupported = unsupportedNodeMessage(process.versions.node, requiredNode);
if (unsupported) {
    console.error(unsupported);
    process.exit(1);
} else {
    import("./run-cli.js").catch(function (error) {
        console.error(error);
        process.exit(1);
    });
}
